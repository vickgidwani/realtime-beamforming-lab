+def prepare_beamform(**kwargs) -> Callable[[], Array]:
+    """Validate and retain a fixed async launch on an explicit CUDA stream.
+
+    Keep all array metadata, storage, and the stream fixed while using the
+    returned callable. The caller orders input writes and output clearing
+    before launch and keeps the buffers alive until all GPU work finishes.
+    The retained adapters create fresh DLPack capsules at each native call.
