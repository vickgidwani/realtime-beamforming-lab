diff --git a/src/mach/kernel.py b/src/mach/kernel.py
index c27a35a..a618d00 100644
--- a/src/mach/kernel.py
+++ b/src/mach/kernel.py
@@ -35,0 +36 @@ def beamform(  # noqa: C901
+    synchronize: bool = True,
@@ -104,0 +106,5 @@ def beamform(  # noqa: C901
+        synchronize:
+            Wait for GPU work before returning. Set to False only when all arrays are
+            CUDA-resident, correctly typed, and contiguous. The kernel is enqueued on
+            CUDA's default stream; retain every input and output array and order any
+            dependent work after it on that stream.
@@ -213,0 +220,26 @@ def beamform(  # noqa: C901
+    # The asynchronous native path returns before the kernel finishes. Do not allow
+    # implicit casts or contiguity fixes to create temporary arrays whose lifetime
+    # would end as soon as this wrapper returns.
+    if not synchronize:
+        is_iq_input = channel_data.dtype in (xp_data.complex64, xp_data.complex128)
+        expected_channel_dtype = xp_data.complex64 if is_iq_input else xp_data.float32
+        async_inputs = (
+            (channel_data, expected_channel_dtype, "channel_data"),
+            (rx_coords_m, xp_coords.float32, "rx_coords_m"),
+            (scan_coords_m, xp_grid.float32, "scan_coords_m"),
+            (tx_wave_arrivals_s, xp_idt.float32, "tx_wave_arrivals_s"),
+        )
+        for array, expected_dtype, name in async_inputs:
+            if array.dtype != expected_dtype:
+                raise ValueError(
+                    f"synchronize=False requires {name} to already have dtype {expected_dtype}; "
+                    "convert it explicitly and retain the converted array until GPU work completes."
+                )
+            if not is_contiguous(cast(Array, array)):
+                raise ValueError(
+                    f"synchronize=False requires {name} to be contiguous; "
+                    "make a contiguous array and retain it until GPU work completes."
+                )
+        if out is not None and not is_contiguous(cast(Array, out)):
+            raise ValueError("synchronize=False requires out to be contiguous")
+
@@ -286,0 +319 @@ def beamform(  # noqa: C901
+        synchronize=synchronize,
